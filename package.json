{
  "name": "o2c-finance-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5174",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4174",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "auth:invite": "node --env-file-if-exists=.env.local --import tsx scripts/invite.ts",
    "test:postgres": "node --env-file-if-exists=.env.local --import tsx --test tests/postgres.integration.ts",
    "test:postgres:http": "node --env-file-if-exists=.env.local --import tsx --test tests/postgres-http.integration.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
