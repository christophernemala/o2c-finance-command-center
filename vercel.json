{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": null,
  "git": {
    "deploymentEnabled": {
      "codex/ai-budget-copilot-hardening": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/agents",
      "schedule": "0 4 * * *"
    }
  ]
}
