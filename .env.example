# Public project credentials only. The app does not use a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only durable sign-in protection. Never prefix these with NEXT_PUBLIC.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret of at least 32 characters and configure it securely.
AUTH_RATE_LIMIT_SECRET=
# Canonical application origin for OAuth and invitation callbacks (no path).
AUTH_SITE_URL=
# Only for npm start bound to 127.0.0.1; omit this setting on hosted deployments.
# AUTH_LOGIN_IP_SOURCE=loopback
