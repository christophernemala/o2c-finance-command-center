# Copy to .env locally; never commit real values. Flask CLI loads it only if
# python-dotenv is installed; otherwise export variables using your secret manager.
O2C_ENV=production
O2C_APP_ORIGIN=https://finance.example.com
O2C_SECRET_KEY=
# Store this database on a private, persistent volume in production.
O2C_DATABASE=/var/lib/o2c/auth.sqlite3
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
