# Public project credentials only. The app does not use a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only durable sign-in protection. Never prefix these with NEXT_PUBLIC.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret of at least 32 characters and configure it securely.
AUTH_RATE_LIMIT_SECRET=
