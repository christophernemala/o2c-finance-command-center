# Server-only direct PostgreSQL connection. Use a restricted runtime login.
# Local example shape: postgresql://o2c_runtime:YOUR_PASSWORD@127.0.0.1:5432/o2c?sslmode=disable
# Managed hosts require verified TLS; use sslmode=verify-full.
DATABASE_URL=
# Schema owner connection, used ONLY by explicit migration/invitation scripts.
# Do not add this privileged variable to the deployed application.
DATABASE_MIGRATION_URL=
# Optional trusted CA PEM for hosts whose certificates are not publicly trusted.
DATABASE_SSL_CA=
# AES-256-GCM key for TOTP secrets. Generate 32 random bytes encoded as base64.
MFA_ENCRYPTION_KEY=
# Durable distributed sign-in and API protection. All variables are server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AUTH_RATE_LIMIT_SECRET=
# Canonical HTTPS application origin (no path). Local dev: http://127.0.0.1:5174
AUTH_SITE_URL=
# Only for npm start bound to 127.0.0.1; omit on hosted deployments.
# AUTH_LOGIN_IP_SOURCE=loopback
