# ============================================================
# O2C Finance Command Center — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is in .gitignore
# ============================================================

# --- SUPABASE (required) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Service role key: server/build side ONLY — never in browser bundle
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- FIRECRAWL (server-side only via Vercel serverless functions) ---
# Rotate your key at https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_KEY

# --- HUGGING FACE (server-side only) ---
HUGGINGFACE_API_KEY=YOUR_HF_KEY

# --- RESEND (server-side only) ---
RESEND_API_KEY=YOUR_RESEND_KEY

# --- HUBSPOT (server-side only) ---
HUBSPOT_ACCESS_TOKEN=YOUR_HUBSPOT_TOKEN

# --- CLOUDFLARE (build/CI only — not exposed to Vite) ---
CLOUDFLARE_ZONE_ID=YOUR_ZONE_ID
CLOUDFLARE_API_TOKEN=YOUR_CF_TOKEN

# --- APP ---
VITE_API_BASE_URL=https://your-vercel-deployment.vercel.app
