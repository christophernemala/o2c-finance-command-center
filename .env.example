# Server-only direct PostgreSQL connection. Use a restricted runtime login.
# Local example shape: postgresql://o2c_runtime:YOUR_PASSWORD@127.0.0.1:5432/o2c?sslmode=disable
# Managed hosts require verified TLS; use sslmode=verify-full.
DATABASE_URL=
# Schema owner connection, used ONLY by explicit migration/invitation scripts.
# Do not add this privileged variable to the deployed application.
DATABASE_MIGRATION_URL=
# Optional trusted CA PEM for hosts whose certificates are not publicly trusted.
DATABASE_SSL_CA=
# AES-256-GCM key for TOTP secrets. Generate 32 random bytes encoded as base64.
MFA_ENCRYPTION_KEY=
# Durable distributed sign-in and API protection. All variables are server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AUTH_RATE_LIMIT_SECRET=
# Canonical HTTPS application origin (no path). Local dev: http://127.0.0.1:5174
AUTH_SITE_URL=
# Only for npm start bound to 127.0.0.1; omit on hosted deployments.
# AUTH_LOGIN_IP_SOURCE=loopback
# Claude API for agents and copilot (server-only). Without it, AI features show "not configured".
ANTHROPIC_API_KEY=
# Collections email (Resend). Without both, approved messages stay queued and the UI says so.
RESEND_API_KEY=
COLLECTIONS_FROM=Accounts Receivable <ar@your-domain.example>
# Optional overrides: model id and effort (low|medium|high|xhigh|max).
# AI_MODEL=claude-opus-5-5
# AI_AGENT_EFFORT=medium
# AI_COPILOT_EFFORT=low
# Vercel Cron bearer secret for /api/cron/agents (32+ random characters).
CRON_SECRET=

# Collections SMS / WhatsApp (Twilio). Missing channel configuration leaves messages queued.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender number, e.g. +15551234567 (must belong to this account).
TWILIO_SMS_FROM=
# WhatsApp-enabled Twilio sender, e.g. whatsapp:+14155238886.
TWILIO_WHATSAPP_FROM=

# Optional work identity providers. Keep all secrets server-only.
# Register exact callbacks: AUTH_SITE_URL/api/auth/oidc/google/callback and
# AUTH_SITE_URL/api/auth/oidc/microsoft/callback. Explicitly allow each preview URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Microsoft Entra directory UUID; common/organizations/multi-tenant issuers are not accepted.
MICROSOFT_TENANT_ID=

# Email sign-in codes for existing confirmed accounts (server-only).
# Resend: set AUTH_EMAIL_FROM and the RESEND_API_KEY above with a verified sender.
AUTH_EMAIL_FROM=
# Or authenticated SMTP with verified TLS: 587/starttls or 465/ssl.
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
